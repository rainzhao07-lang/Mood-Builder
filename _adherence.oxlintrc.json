{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/data/**",
              "components/frame/**",
              "components/inputs/**",
              "components/surfaces/**",
              "ui_kits/mood-builder-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fraunces|Newsreader|Hanken Grotesk|Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Fraunces, Newsreader, Hanken Grotesk, Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|disabled|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, disabled, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|solid|quiet|onDark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'solid' | 'quiet' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|elevation|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, elevation, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|deep|paper)$/]",
        "message": "<Card> tone must be one of 'default' | 'deep' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='elevation'] > Literal[value!=/^(?:flat|raised)$/]",
        "message": "<Card> elevation must be one of 'flat' | 'raised'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmotionWheel'] > JSXAttribute > JSXIdentifier[name!=/^(?:defaultX|defaultY|onChange|key|ref|className|style|children)$/]",
        "message": "<EmotionWheel> doesn't accept that prop. Declared props: defaultX, defaultY, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhoneFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|screen|dark|time|style|key|ref|className|style|children)$/]",
        "message": "<PhoneFrame> doesn't accept that prop. Declared props: children, screen, dark, time, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|color|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:gold|sage|slate)$/]",
        "message": "<ProgressBar> color must be one of 'gold' | 'sage' | 'slate'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignalRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|status|statusText|value|unit|style|key|ref|className|style|children)$/]",
        "message": "<SignalRow> doesn't accept that prop. Declared props: label, status, statusText, value, unit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignalRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:rest|warn|alert)$/]",
        "message": "<SignalRow> status must be one of 'rest' | 'warn' | 'alert'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|defaultValue|value|onChange|mode|min|max|display|style|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: label, defaultValue, value, onChange, mode, min, max, display, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:percent|tone|layout|raw)$/]",
        "message": "<Slider> mode must be one of 'percent' | 'tone' | 'layout' | 'raw'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpaceTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|height|cover|caption|metaLeft|metaRight|style|key|ref|className|style|children)$/]",
        "message": "<SpaceTile> doesn't accept that prop. Declared props: src, alt, height, cover, caption, metaLeft, metaRight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StageBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:stage|total|note|style|key|ref|className|style|children)$/]",
        "message": "<StageBar> doesn't accept that prop. Declared props: stage, total, note, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
